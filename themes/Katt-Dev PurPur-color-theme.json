{
    "name": "Katt-Dev PurPur",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "keyword": "#ff6ac1",
        "modifier": "#ff6ac1",
        "type": {
            "foreground": "#ffd32a",
            "bold": true
        },
        "class": {
            "foreground": "#ffd32a",
            "bold": true
        },
        "interface": {
            "foreground": "#ffd32a",
            "bold": true
        },
        "enum": {
            "foreground": "#ffd32a",
            "bold": true
        },
        "enumMember": "#ff9f43",
        "function": "#54a0ff",
        "method": "#54a0ff",
        "parameter": {
            "foreground": "#ff9f43",
            "italic": true
        },
        "variable": "#c7ecee",
        "property": "#ff9f43",
        "comment": {
            "foreground": "#7f7694",
            "italic": true
        },
        "string": "#2ed573",
        "number": "#ff9f43",
        "operator": "#dfe4ea",
        "namespace": "#ffd32a"
    },
    "colors": {
        "editor.background": "#120e17",
        "editor.foreground": "#dcd3eb",
        "editor.lineHighlightBackground": "#1b1524",
        "editor.selectionBackground": "#331c4e",
        
        "activityBar.background": "#0b080f",
        "activityBar.border": "#211438",
        "activityBar.foreground": "#c4a5f0",
        "activityBar.inactiveForeground": "#49395e",
        "activityBar.activeBackground": "#1c112b",
        "activityBar.activeBorder": "#967bbd",
        "activityBarBadge.background": "#967bbd",
        
        "sideBar.background": "#0e0a13",
        "sideBar.border": "#211438",
        "sideBarTitle.foreground": "#967bbd",
        "sideBarSectionHeader.background": "#0e0a13",
        "sideBarSectionHeader.border": "#211438",
        
        "editorGroupHeader.tabsBackground": "#0e0a13",
        "tab.activeBackground": "#120e17",
        "tab.inactiveBackground": "#0e0a13",
        "tab.border": "#211438",
        "tab.activeBorderTop": "#967bbd",
        "tab.activeForeground": "#dcd3eb",
        
        "titleBar.activeBackground": "#0b080f",
        "titleBar.inactiveBackground": "#0b080f",
        "titleBar.activeForeground": "#dcd3eb",
        "panel.background": "#0e0a13",
        "panel.border": "#211438",
        "statusBar.background": "#140e1f",
        "statusBar.foreground": "#dcd3eb",
        "statusBar.border": "#211438"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#7f7694"
            }
        },
        {
            "name": "Keywords & Control",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#ff6ac1"
            }
        },
        {
            "name": "Classes & Inheritance",
            "scope": [
                "entity.name.type.class",
                "entity.name.class",
                "support.class"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#ffd32a"
            }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#54a0ff"
            }
        },
        {
            "name": "Self & Language Variables",
            "scope": [
                "variable.language.special.self.python",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#ff9f43"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#ff9f43"
            }
        },
        {
            "name": "Named Arguments / Properties",
            "scope": [
                "variable.parameter.function-call",
                "entity.other.attribute-name"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#ff9f43"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#2ed573"
            }
        },
        {
            "name": "Numbers & Hex Values",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#ff9f43"
            }
        },
        {
            "name": "Decorators",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#ff6ac1"
            }
        },
        {
            "name": "Variables & Default Text",
            "scope": [
                "variable",
                "variable.other.readwrite"
            ],
            "settings": {
                "foreground": "#c7ecee"
            }
        },
        {
            "name": "Operators & Punctuation",
            "scope": [
                "keyword.operator",
                "punctuation"
            ],
            "settings": {
                "foreground": "#dfe4ea"
            }
        },
        {
            "name": "Function Parameters",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#ff9f43"
            }
        },
        {
            "name": "Colors",
            "scope": [
                "constant.other.color"
            ],
            "settings": {
                "foreground": "#ffffff"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#ff4757"
            }
        },
        {
            "name": "Keyword, Storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#ff6ac1"
            }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "constant.other.color",
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution",
                "keyword.operator"
            ],
            "settings": {
                "foreground": "#dfe4ea"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": {
                "foreground": "#ff6ac1"
            }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": {
                "foreground": "#54a0ff"
            }
        },
        {
            "name": "Block Level Variables",
            "scope": [
                "meta.block variable.other"
            ],
            "settings": {
                "foreground": "#c7ecee"
            }
        },
        {
            "name": "Other Variable, String Link",
            "scope": [
                "support.other.variable",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#54a0ff"
            }
        },
        {
            "name": "Number, Constant, Function Argument, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": {
                "foreground": "#ff9f43"
            }
        },
        {
            "name": "String, Symbols, Markup Heading",
            "scope": [
                "string",
                "punctuation.definition.string",
                "constant.other.symbol",
                "constant.other.key",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": {
                "foreground": "#2ed573"
            }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.other.inherited-class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#ffd32a"
            }
        },
        {
            "name": "Entity Types",
            "scope": [
                "support.type"
            ],
            "settings": {
                "foreground": "#ffd32a"
            }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": {
                "foreground": "#ffd32a"
            }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": {
                "foreground": "#54a0ff"
            }
        },
        {
            "name": "Language methods",
            "scope": [
                "variable.language"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#54a0ff"
            }
        },
        {
            "name": "entity.name.method.js",
            "scope": [
                "entity.name.method.js"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#54a0ff"
            }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": {
                "foreground": "#54a0ff"
            }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name",
                "variable.other.property"
            ],
            "settings": {
                "foreground": "#ff9f43"
            }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
